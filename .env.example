# PostgreSQL
POSTGRES_DB=order_system
POSTGRES_USER=order_system
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://order_system:change-me@localhost:5432/order_system

# Kafka
# Use localhost when connecting from the host machine.
KAFKA_EXTERNAL_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NEW_ORDERS_TOPIC=new-orders
KAFKA_CONSUMER_GROUP=order-processor

# Backend
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Prometheus
PROMETHEUS_PORT=9090
